{
  "name": "html-video-element-webworker-polyfill",
  "version": "0.1.0",
  "description": "HTMLVideoElement inside Web Workers: a main-thread <video> mirrored into the worker with synchronous state, events and VideoFrames, plus Canvas 2D / WebGL / WebGPU polyfills.",
  "keywords": [
    "htmlvideoelement",
    "offscreencanvas",
    "polyfill",
    "video",
    "videoframe",
    "webcodecs",
    "webgl",
    "webgpu",
    "webworker",
    "worker"
  ],
  "homepage": "https://stepancar.github.io/html-video-element-webworker-polyfill/",
  "bugs": {
    "url": "https://github.com/stepancar/html-video-element-webworker-polyfill/issues"
  },
  "license": "Apache-2.0",
  "author": "Stepan Mikhailiuk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stepancar/html-video-element-webworker-polyfill.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/auto.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "default": "./dist/host.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./canvas2d": {
      "types": "./dist/canvas2d.d.ts",
      "default": "./dist/canvas2d.js"
    },
    "./webgl": {
      "types": "./dist/webgl.d.ts",
      "default": "./dist/webgl.js"
    },
    "./webgpu": {
      "types": "./dist/webgpu.d.ts",
      "default": "./dist/webgpu.js"
    },
    "./image-bitmap": {
      "types": "./dist/image-bitmap.d.ts",
      "default": "./dist/image-bitmap.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "default": "./dist/auto.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p . && tsc -p test && tsc -p demo && tsc -p tsconfig.node.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update": "vitest run --update",
    "demo:dev": "vite demo",
    "demo:build": "vite build demo",
    "prepublishOnly": "npm run build",
    "check:treeshake": "node scripts/check-treeshake.mjs",
    "test:update-linux": "scripts/update-linux-screenshots.sh"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/browser": "^5.0.4",
    "@vitest/browser-playwright": "^5.0.4",
    "@webgpu/types": "^0.1.74",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "playwright": "^1.64.0",
    "rolldown": "1.2.13",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=20"
  }
}
